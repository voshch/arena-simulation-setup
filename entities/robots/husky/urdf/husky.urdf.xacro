<?xml version="1.0"?>
<robot name="husky" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =================================================================== -->
  <!--           这是一个最终的、自包含的Husky URDF                       -->
  <!--      合并了所有子文件，以解决Gazebo中的mesh路径问题             -->
  <!-- =================================================================== -->

  <!-- 定义常量 -->
  <xacro:property name="M_PI" value="3.14159"/>

  <!-- 机器人尺寸 -->
  <xacro:property name="base_x_size" value="0.9874" />
  <xacro:property name="base_y_size" value="0.5709" />
  <xacro:property name="base_z_size" value="0.2475" />

  <!-- 轮子安装位置 -->
  <xacro:property name="wheelbase" value="0.5120" />
  <xacro:property name="track" value="0.5708" />
  <xacro:property name="wheel_vertical_offset" value="0.03282" />

  <!-- 轮子属性 -->
  <xacro:property name="wheel_length" value="0.1143" />
  <xacro:property name="wheel_radius" value="0.1651" />

  <!-- =================================================================== -->
  <!--               ↓↓↓ 核心修改区域 (1/2) ↓↓↓                          -->
  <!--      将 wheel.urdf.xacro 和 decorations.urdf.xacro 的内容        -->
  <!--      直接定义为宏，并在这里调用                                      -->
  <!-- =================================================================== -->

  <!-- 定义轮子宏 (从 wheel.urdf.xacro 合并) -->
  <xacro:macro name="husky_wheel" params="wheel_prefix *joint_pose">
    <link name="${wheel_prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" />
        <geometry>
          <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
      <inertial>
          <mass value="2.637" />
          <origin xyz="0 0 0" />
          <inertia ixx="0.02467" ixy="0" ixz="0" iyy="0.04411" iyz="0" izz="0.02467" />
      </inertial>
    </link>
    <joint name="${wheel_prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${wheel_prefix}_wheel_link" />
      <xacro:insert_block name="joint_pose" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <!-- 定义装饰宏 (从 decorations.urdf.xacro 合并) -->
  <xacro:macro name="husky_decorate">
    <link name="top_chassis_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/top_chassis.dae"/>
        </geometry>
      </visual>
    </link>
    <joint name="top_chassis_joint" type="fixed">
      <parent link="base_link"/>
      <child link="top_chassis_link"/>
    </joint>

    <link name="front_bumper_link">
      <visual>
        <geometry>
          <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/bumper.dae"/>
        </geometry>
      </visual>
    </link>
    <joint name="front_bumper" type="fixed">
      <origin xyz="${base_x_size/2} 0 0.0568" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="front_bumper_link"/>
    </joint>

    <link name="rear_bumper_link">
      <visual>
        <geometry>
          <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/bumper.dae"/>
        </geometry>
      </visual>
    </link>
    <joint name="rear_bumper" type="fixed">
      <origin xyz="-${base_x_size/2} 0 0.0568" rpy="0 0 3.14159"/>
      <parent link="base_link"/>
      <child link="rear_bumper_link"/>
    </joint>

    <link name="user_rail_link">
      <visual>
        <geometry>
          <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/user_rail.dae"/>
        </geometry>
      </visual>
    </link>
    <joint name="user_rail" type="fixed">
      <origin xyz="0.272 0 0.245" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="user_rail_link"/>
    </joint>

    <link name="top_plate_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/top_plate.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/top_plate.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="top_plate_joint" type="fixed">
        <origin xyz="0.0812 0 0.2475" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="top_plate_link"/>
    </joint>
  </xacro:macro>

  <!-- =================================================================== -->
  <!--               ↓↓↓ 机器人本体定义 ↓↓↓                              -->
  <!-- =================================================================== -->

  <!-- Base link (机器人主干) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://arena_simulation_setup/entities/robots/husky/meshes/base_link.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z_size/2 - 0.032}" rpy="0 0 0" />
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
      </geometry>
    </collision>
  </link>

  <!-- Base footprint (机器人足迹) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${-base_z_size/2}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="base_footprint" />
  </joint>

  <!-- Inertial link (惯性环节) -->
  <link name="inertial_link">
    <inertial>
      <mass value="46.034" />
      <origin xyz="-0.00065 -0.085 0.062" />
      <inertia ixx="0.6022" ixy="-0.02364" ixz="-0.1197" iyy="1.7386" iyz="-0.001544" izz="2.0296" />
    </inertial>
  </link>
  <joint name="inertial_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="inertial_link" />
  </joint>

  <!-- IMU link (惯性测量单元) -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.19 0 0.149" rpy="0 -1.5708 3.1416" />
    <parent link="base_link" />
    <child link="imu_link" />
  </joint>

  <!-- Laser link (激光雷达) -->
  <link name="laser_link"/>
  <joint name="laser_joint" type="fixed">
      <origin xyz="0.25 0 0.2" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="laser_link"/>
  </joint>

  <!-- 调用宏来创建轮子 -->
  <xacro:husky_wheel wheel_prefix="front_left">
    <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:husky_wheel>
  <xacro:husky_wheel wheel_prefix="front_right">
    <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:husky_wheel>
  <xacro:husky_wheel wheel_prefix="rear_left">
    <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:husky_wheel>
  <xacro:husky_wheel wheel_prefix="rear_right">
    <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="0 0 0" />
  </xacro:husky_wheel>

  <!-- 调用宏来创建装饰 -->
  <xacro:husky_decorate />

  <!-- =================================================================== -->
  <!--               ↓↓↓ 核心修改区域 (2/2) ↓↓↓                          -->
  <!--      像Jackal一样，直接在这里集成ros2_control                     -->
  <!-- =================================================================== -->
  <ros2_control name="husky_hardware" type="system">
    <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- 包含Gazebo传感器插件 -->
  <xacro:include filename="$(find arena_simulation_setup)/entities/robots/husky/urdf/husky.gazebo" />

</robot>
