<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="rbkairos_gz_ignition_control"  params="namespace prefix">
      <gazebo>

        <!-- <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin" filename="gz_ros2_control-system">
          <robot_param>robot_description</robot_param>
          <robot_param_node>robot_state_publisher</robot_param_node>
          <parameters>$(find arena_simulation_setup)/entities/robots/rbkairos/simulators/gazebo_ignition/rbkairos/rbkairos_controller_params.yaml</parameters>
          <ros>
              <namespace>/${namespace}</namespace>
          </ros>
        </plugin> -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
          <left_joint>robot_back_left_wheel_joint</left_joint>
          <right_joint>robot_front_right_wheel_joint</right_joint>
          <left_joint>robot_front_left_wheel_joint</left_joint>
          <right_joint>robot_back_right_wheel_joint</right_joint>
          <!-- <wheel_separation>0.48</wheel_separation>
          <wheel_radius>0.095</wheel_radius>
          <odom_publish_frequency>50</odom_publish_frequency> -->
          <wheel_separation>0.70</wheel_separation>
          <wheel_radius>0.10</wheel_radius>
          <odom_publish_frequency>50</odom_publish_frequency>
          <publish_odom>true</publish_odom>
          <publish_odom_tf>true</publish_odom_tf>
          <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>
      </gazebo>

      <xacro:macro name="ros2_joint" params="interface jmin jmax name">
        <joint name="${name}">
          <command_interface name="${interface}">
            <param name="min">${jmin}</param>
            <param name="max">${jmax}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <!-- <ros2_control name="IgnitionSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <xacro:ros2_joint interface="velocity" jmin="-10" jmax="10" name="${prefix}front_left_wheel_joint"/>
        <xacro:ros2_joint interface="velocity" jmin="-10" jmax="10" name="${prefix}front_right_wheel_joint"/>
        <xacro:ros2_joint interface="velocity" jmin="-20" jmax="20" name="${prefix}back_left_wheel_joint"/>
        <xacro:ros2_joint interface="velocity" jmin="-20" jmax="20" name="${prefix}back_right_wheel_joint"/>

      </ros2_control> -->
  </xacro:macro>
</robot>
